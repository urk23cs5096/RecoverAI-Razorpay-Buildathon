# ==============================================================================
# RecoverAI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: All settings have production-ready defaults. LLM keys are optional;
# if omitted, RecoverAI automatically uses its deterministic fallback synthesizer.

# Server & Network Configuration
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PORT=8501

# Storage
DATABASE_URL=sqlite:///./recoverai.db

# Optional AI / LLM SDK Keys
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
LLM_PROVIDER=mock_fallback
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Safety Guardrails & Business Invariants
MAX_RECOVERY_ATTEMPTS=3
COMMUNICATION_COOLDOWN_HOURS=24
HIGH_VALUE_THRESHOLD_INR=50000.0
MIN_EXPECTED_VALUE_INR=5.0
